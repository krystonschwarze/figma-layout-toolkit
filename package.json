{
  "name": "figma-layout-toolkit",
  "version": "1.0.0",
  "private": true,
  "description": "Figma plugin that sets hug and fill sizing, fit to parent, text alignment and auto layout alignment across whole layer trees in one run.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/build.mjs --minify",
    "dev": "node scripts/build.mjs --watch",
    "preview": "node scripts/preview.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:ui-kit": "node scripts/sync-ui-kit.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@figma/eslint-plugin-figma-plugins": "^1.0.0",
    "@figma/plugin-typings": "^1.131.0",
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
